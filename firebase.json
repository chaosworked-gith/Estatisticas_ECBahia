{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "predeploy": ["node scripts/gerar-historia.js"],
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "scripts/**",
      "*.log",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
